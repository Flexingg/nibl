<?xml version="1.0" encoding="utf-8"?>
<!-- Two pre-drawn looks (light and dark), each a loop of frames of the moving wave; the day/night layout shows the right one -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/flip_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="170"
        android:visibility="visible" />

    <ViewFlipper
        android:id="@+id/flip_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="170"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/tap_water"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Add water" />
    </LinearLayout>
</FrameLayout>
