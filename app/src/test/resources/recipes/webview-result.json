"\u003Chtml>\u003Chead>\u003Ctitle>JS Recipe\u003C/title>\u003Cscript type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Recipe\",\"name\":\"Rendered Chili &amp; Beans\",\"recipeYield\":\"4 servings\",\"prepTime\":\"PT10M\",\"cookTime\":\"PT30M\",\"recipeIngredient\":[\"1 lb ground turkey\",\"1 (15 oz) can black beans\"],\"recipeInstructions\":[{\"@type\":\"HowToStep\",\"text\":\"Brown the turkey 8 minutes.\"},{\"@type\":\"HowToStep\",\"text\":\"Add beans, simmer 20 minutes.\"}]}\u003C/script>\u003C/head>\u003Cbody>\u003Cdiv id=\"app\">Ready\u003C/div>\n\u003Cscript>\n// Simulates a site that builds its recipe markup with JavaScript after load.\nsetTimeout(function () {\n  var s = document.createElement('script');\n  s.type = 'application/ld+json';\n  s.text = JSON.stringify({\"@context\":\"https://schema.org\",\"@type\":\"Recipe\",\"name\":\"Rendered Chili &amp; Beans\",\n    \"recipeYield\":\"4 servings\",\"prepTime\":\"PT10M\",\"cookTime\":\"PT30M\",\n    \"recipeIngredient\":[\"1 lb ground turkey\",\"1 (15 oz) can black beans\"],\n    \"recipeInstructions\":[{\"@type\":\"HowToStep\",\"text\":\"Brown the turkey 8 minutes.\"},{\"@type\":\"HowToStep\",\"text\":\"Add beans, simmer 20 minutes.\"}]});\n  document.head.appendChild(s);\n  document.getElementById('app').textContent = 'Ready';\n}, 800);\n\u003C/script>\n\u003C/body>\u003C/html>"